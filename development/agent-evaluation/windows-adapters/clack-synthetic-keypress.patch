 	private onKeypress(char: string | undefined, key: Key) {
+		const syntheticInput = (
+			this.input as Readable & { agentbaseSyntheticKeypress?: boolean }
+		).agentbaseSyntheticKeypress;
 		if (this._track && key.name !== 'return') {
+			if (syntheticInput && this.rl) {
+				const cursor = this.rl.cursor;
+				switch (key.name) {
+					case 'backspace':
+						if (cursor > 0) {
+							this.rl.line = `${this.rl.line.slice(0, cursor - 1)}${this.rl.line.slice(cursor)}`;
+							this.rl.cursor = cursor - 1;
+						}
+						break;
+					case 'delete':
+						this.rl.line = `${this.rl.line.slice(0, cursor)}${this.rl.line.slice(cursor + 1)}`;
+						break;
+					case 'left':
+						this.rl.cursor = Math.max(0, cursor - 1);
+						break;
+					case 'right':
+						this.rl.cursor = Math.min(this.rl.line.length, cursor + 1);
+						break;
+					case 'home':
+						this.rl.cursor = 0;
+						break;
+					case 'end':
+						this.rl.cursor = this.rl.line.length;
+						break;
+				}
+			}
 			if (key.name && this._isActionKey(char, key)) {
-				this.rl?.write(null, { ctrl: true, name: 'h' });
+				if (syntheticInput && this.rl && char && this.rl.cursor > 0) {
+					const cursor = this.rl.cursor;
+					this.rl.line = `${this.rl.line.slice(0, cursor - 1)}${this.rl.line.slice(cursor)}`;
+					this.rl.cursor = cursor - 1;
+				} else {
+					this.rl?.write(null, { ctrl: true, name: 'h' });
+				}
 			}
 			this._cursor = this.rl?.cursor ?? 0;
 			this._setUserInput(this.rl?.line);
