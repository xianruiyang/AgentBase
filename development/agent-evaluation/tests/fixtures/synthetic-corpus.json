        { "argv": ["{python}", "-m", "pip", "--version"], "timeout_seconds": 30 }
      ],
      "setup_cleanup": { "restore_tracked": [], "remove_untracked": [] },
      "checks": [
        {
          "id": "base",
          "bucket": "base",
          "argv": ["{python}", "-m", "pytest", "tests/base.py", "--junitxml={report}"],
          "timeout_seconds": 30,
          "report": { "kind": "junit", "path": ".agentbase/reports/base.xml" }
        },
        {
          "id": "new",
          "bucket": "new",
          "argv": ["{python}", "-m", "pytest", "tests/new.py", "--junitxml={report}"],
          "timeout_seconds": 30,
          "report": { "kind": "junit", "path": ".agentbase/reports/new.xml" }
