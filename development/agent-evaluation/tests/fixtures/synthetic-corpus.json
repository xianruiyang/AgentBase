      "language": "python",
      "repository": "https://example.invalid/synthetic-repository.git",
      "upstream_base_commit": "2222222222222222222222222222222222222222",
      "capabilities": ["editing", "testing"],
      "allowed_patch_paths": ["src/value.py"],
      "assets": {
        "instruction.md": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "task.toml": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "solution/solution.patch": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "tests/test.patch": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "tests/config.json": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
