    {"id":"AST-SCAN-STRUCTURED","backend":"ast-grep","selector":"scan finding or SARIF machine output","handling":"structured","sideEffects":"read-only-or-preview"},
    {"id":"AST-SCAN-REPORT","backend":"ast-grep","selector":"scan with explicit text/files/github report","handling":"bounded-text","sideEffects":"read-only-or-preview"},
