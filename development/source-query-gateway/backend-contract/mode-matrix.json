{
  "schema": "agentbase.source-query-mode-matrix/v1",
  "classificationRule": "Map each invocation to one primary mode by native output, protocol, or side-effect precedence; preserve all remaining native argv as ordered modifiers.",
  "handling": {
    "adaptive": "wrapper may choose only among EvidenceSignature-equivalent structured views",
    "structured": "wrapper parses a versioned native machine format without changing the native query or side-effect set",
    "bounded-text": "wrapper may bound model-visible text while preserving native exit and completeness diagnostics",
    "artifact": "native bytes require an explicit output artifact and stdout returns only its manifest",
    "passthrough": "stdin/stdout/TTY and exit remain native; wrapper does not serialize the channel"
  },
  "modes": [
    {"id":"RG-SEARCH-TEXT","backend":"rg","selector":"default search output","handling":"adaptive","sideEffects":"read-only"},
    {"id":"RG-SEARCH-JSON","backend":"rg","selector":"--json","handling":"structured","sideEffects":"read-only"},
    {"id":"RG-FILES","backend":"rg","selector":"--files","handling":"adaptive","sideEffects":"read-only"},
    {"id":"RG-FILES-WITH-MATCHES","backend":"rg","selector":"-l|--files-with-matches","handling":"adaptive","sideEffects":"read-only"},
    {"id":"RG-FILES-WITHOUT-MATCH","backend":"rg","selector":"--files-without-match","handling":"adaptive","sideEffects":"read-only"},
    {"id":"RG-COUNT","backend":"rg","selector":"-c|--count","handling":"structured","sideEffects":"read-only"},
    {"id":"RG-COUNT-MATCHES","backend":"rg","selector":"--count-matches","handling":"structured","sideEffects":"read-only"},
    {"id":"RG-ONLY-MATCHING","backend":"rg","selector":"-o|--only-matching","handling":"adaptive","sideEffects":"read-only"},
    {"id":"RG-VIMGREP","backend":"rg","selector":"--vimgrep","handling":"structured","sideEffects":"read-only"},
    {"id":"RG-REPLACE-DISPLAY","backend":"rg","selector":"-r|--replace","handling":"bounded-text","sideEffects":"read-only-output-transform"},
