    {"id":"AST-COMPLETIONS","backend":"ast-grep","selector":"completions","handling":"artifact","sideEffects":"read-only-generation"},
    {"id":"AST-HELP","backend":"ast-grep","selector":"help|-h|--help","handling":"bounded-text","sideEffects":"none"},
    {"id":"AST-VERSION","backend":"ast-grep","selector":"-V|--version","handling":"bounded-text","sideEffects":"none"},
    {"id":"AST-UNKNOWN-FUTURE","backend":"ast-grep","selector":"unknown command accepted by newer engine","handling":"bounded-text","sideEffects":"unknown-native-semantics"}
