    {"id":"FD-PRINT0","backend":"fd","selector":"-0|--print0","handling":"artifact","sideEffects":"read-only"},
    {"id":"FD-EXEC","backend":"fd","selector":"-x|--exec","handling":"passthrough","sideEffects":"executes-user-command-per-result"},
