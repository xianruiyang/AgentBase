    {"id":"RG-NUL-PATHS","backend":"rg","selector":"-0|--null","handling":"artifact","sideEffects":"read-only"},
    {"id":"RG-NULL-DATA","backend":"rg","selector":"--null-data","handling":"artifact","sideEffects":"read-only"},
