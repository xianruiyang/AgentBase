{
  "schema": "agentbase.source-query-routing-cases/v1",
  "cases": [
    {"id":"sqg-known-file","prompt":"在已知目录里找到唯一的 FooConfig.toml，只返回路径。","expected":{"route":"native_fast","reference":"none"}},
    {"id":"sqg-known-file-text","prompt":"已知文件 src/config.rs，定位其中最多三处 DEFAULT_LIMIT 并返回所在行。","expected":{"route":"native_fast","reference":"none"}},
    {"id":"sqg-known-definition","prompt":"已知函数名与实现文件，返回该函数完整定义；先文本定位并有界读取即可可靠界定。","expected":{"route":"native_fast","reference":"none"}},
    {"id":"sqg-exhaustive-text","prompt":"列出整个源码树里 dispatch_request 的全部正文出现位置，并证明没有遗漏。","expected":{"route":"sgy_rgfd","reference":"none"}},
    {"id":"sqg-absence","prompt":"确认生产源码中不存在旧错误码 LegacyTransportError，结论依赖全集。","expected":{"route":"sgy_rgfd","reference":"none"}},
    {"id":"sqg-deep-tree","prompt":"查找所有生成器入口文件，结果很多且共享深层目录前缀，完整返回文件集合。","expected":{"route":"sgy_rgfd","reference":"none"}},
    {"id":"sqg-query-sgy-terms","prompt":"搜索项目源码与文档中所有提及 process containing 的位置；这是被查询文本，不是要求执行 AST process。","expected":{"route":"sgy_rgfd","reference":"none"}},
    {"id":"sqg-authoritative-root","prompt":"两个源码根出现同名同责实现，其中一个是发布打包副本；返回正式开发源码全集并说明完整性。","expected":{"route":"sgy_rgfd","reference":"none"}},
    {"id":"sqg-relation-endpoints","prompt":"查明一个类型定义如何被某个具体接口响应暴露；返回定义、承载字段和接口映射三个端点的位置。","expected":{"route":"native_fast","reference":"none"}},
    {"id":"sqg-line-budget","prompt":"列出全部五处已知命中，最多八行且不要空行。","expected":{"route":"native_fast","reference":"none"}},
    {"id":"sqg-rg-special","prompt":"需要使用 ripgrep 15.1.0 的 --count-matches 原生语义，并保留退出与完整性。","expected":{"route":"sgy_rgfd","reference":"rg-fd"}},
    {"id":"sqg-fd-exec","prompt":"找到文件后批量执行格式化命令。","expected":{"route":"sgy_rgfd","reference":"rg-fd","authorization_required":true}},
    {"id":"sqg-ast-call-shape","prompt":"定位所有第一个参数是字符串字面量的 register 调用，普通文本会误判。","expected":{"route":"sgy_ast","reference":"ast"}},
    {"id":"sqg-containing","prompt":"给定一处命中，返回包含它的最小完整函数定义范围。","expected":{"route":"sgy_ast","reference":"ast"}},
    {"id":"sqg-rewrite","prompt":"把满足结构规则的旧调用改为新调用。","expected":{"route":"sgy_ast","reference":"ast","authorization_required":true,"preview_required":true}},
    {"id":"sqg-overload","prompt":"这个调用到底绑定到哪个重载定义？文本和语法形状相同但类型不同。","expected":{"route":"lsp","reference":"none"}},
    {"id":"sqg-exact-refs","prompt":"安全重命名符号并只修改编译器认定的真实引用。","expected":{"route":"lsp","reference":"none","authorization_required":true}},
    {"id":"sqg-enough-evidence","prompt":"已读取完整目标定义并足以回答，不需要再找其他位置。请直接作答。","expected":{"route":"no_query","reference":"none"}},
    {"id":"sqg-nonsource","prompt":"评价这个对话框的视觉层级和按钮布局，不涉及查找源码。","expected":{"route":"no_skill","reference":"none"}},
    {"id":"sqg-rule-review","prompt":"只审查正式查询规则如何描述 AST 与 srcq 的关系，不执行 AST、LSP 或特殊输出查询。","expected":{"route":"no_skill","reference":"none"}},
    {"id":"sqg-large-page","prompt":"当前结果页出现 @more，且尚未展示的结果是完整性结论的必要证据；继续同一查询并保持同一表示。","expected":{"route":"sgy_rgfd","reference":"none","same_snapshot_required":true}},
    {"id":"sqg-irrelevant-cut","prompt":"srcq 输出有 @cut，但请求所需的文件与行号已经完整显示，现有证据足以回答。","expected":{"route":"no_query","reference":"none"}},
    {"id":"sqg-ast-cache","prompt":"同一源码快照里连续查询三个不同函数的完整 AST 范围。","expected":{"route":"sgy_ast","reference":"ast"}}
  ]
