{
  "schema": "agentbase.codex-shell-environment-policy/v1",
  "inherit": "all",
  "ignore_default_excludes": false,
  "experimental_use_profile": false,
  "filters": {
    "ALL_PROXY": "exclude",
    "HTTP_PROXY": "exclude",
    "HTTPS_PROXY": "exclude",
    "NO_PROXY": "exclude",
    "SSL_CERT_FILE": "exclude",
    "CODEX_*": "exclude",
    "OPENAI_*": "exclude",
    "GIT_*": "exclude",
    "GH_*": "exclude",
    "GITHUB_*": "exclude",
    "SSH_*": "exclude",
    "AWS_*": "exclude",
    "AZURE_*": "exclude",
    "GOOGLE_*": "exclude",
    "NPM_*": "exclude",
    "PIP_*": "exclude",
    "PYPI_*": "exclude",
    "GPG_*": "exclude",
    "GNUPGHOME": "exclude",
    "NODE_OPTIONS": "exclude",
    "NODE_PATH": "exclude",
    "PYTHONHOME": "exclude",
    "PYTHONPATH": "exclude",
    "PYTHONSTARTUP": "exclude",
    "VIRTUAL_ENV": "exclude",
    "CONDA_*": "exclude",
    "CI": "exclude",
    "*PASSWORD*": "exclude",
    "*CREDENTIAL*": "exclude",
    "*AUTH_TOKEN*": "exclude"
  }
}
