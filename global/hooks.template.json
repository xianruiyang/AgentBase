{
  "description": "AgentBase reasoning-state context, event logging, and opt-in QQ completion hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\reasoning-governor\\scripts\\reasoning-governor.ps1\" -Hook",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\reasoning-governor\\scripts\\reasoning-governor.ps1\" -Hook",
            "timeout": 8,
            "additionalContextLimit": 32
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "timeout": 10,
            "statusMessage": "Recording Codex user prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "timeout": 10,
            "statusMessage": "Recording Codex turn stop"
          },
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-qq-hook\\scripts\\codex_stop_qq_notify.ps1\" -CodexRoot \"{{CODEX_ROOT}}\"",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-qq-hook\\scripts\\codex_stop_qq_notify.ps1\" -CodexRoot \"{{CODEX_ROOT}}\"",
            "timeout": 30,
            "statusMessage": "Sending QQ completion notification"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "timeout": 10,
            "statusMessage": "Recording Codex pre-tool snapshot"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "commandWindows": "pwsh.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"{{CODEX_ROOT}}\\skills\\codex-event-logger\\scripts\\codex_event_logger.ps1\"",
            "timeout": 10,
            "statusMessage": "Recording Codex file operations"
          }
        ]
      }
    ]
  }
}
